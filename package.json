{
  "name": "serverless-order-integration",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first serverless order integration learning project.",
  "type": "module",
  "workspaces": [
    "ui"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run check --workspace ui",
    "cloud:deploy": "node scripts/cloud/development-lab.mjs deploy",
    "cloud:destroy": "node scripts/cloud/development-lab.mjs destroy",
    "cloud:order:create": "node scripts/cloud/development-lab.mjs create-order",
    "cloud:status": "node scripts/cloud/development-lab.mjs status",
    "deployment:validate": "node --check scripts/cloud/development-lab.mjs && node --check scripts/cloud/development-lab-state.mjs && node --check scripts/cloud/cloud-ui-configuration.mjs && node --check scripts/cloud/stripe-webhook-lifecycle.mjs && node scripts/ci/validate-github-oidc-bootstrap.mjs && bash -n scripts/ci/prepare-development-change-set.sh scripts/ci/execute-development-change-set.sh scripts/ci/smoke-development-stack.sh scripts/ci/destroy-development-stack.sh",
    "dynamodb:bootstrap": "npm run dynamodb:start && bash scripts/dynamodb/bootstrap-local.sh",
    "dynamodb:reset": "docker compose down --volumes",
    "dynamodb:start": "docker compose up --detach --wait dynamodb-local",
    "dynamodb:stop": "docker compose stop dynamodb-local",
    "dynamodb:verify": "AWS_ACCESS_KEY_ID=DUMMYIDEXAMPLE AWS_SECRET_ACCESS_KEY=DUMMYEXAMPLEKEY aws dynamodb list-tables --endpoint-url http://127.0.0.1:8000 --region eu-central-1 --no-cli-pager",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "local:lab": "node scripts/local/development-lab.mjs",
    "mock-vendor:start": "npm run build && node --env-file=.env.development.local scripts/mock-vendor/start-local.mjs",
    "oidc:validate": "npm run deployment:validate && SAM_CLI_TELEMETRY=0 sam validate --lint --template-file infrastructure/github-oidc-bootstrap.yaml",
    "sam:build": "SAM_CLI_TELEMETRY=0 sam build",
    "sam:cloud:build": "SAM_CLI_TELEMETRY=0 sam build --template-file template.cloud.yaml --build-dir .aws-sam/cloud-build",
    "sam:cloud:validate": "SAM_CLI_TELEMETRY=0 sam validate --lint --template-file template.cloud.yaml",
    "sam:local": "npm run dynamodb:bootstrap && npm run sam:build && node scripts/sam/start-local.mjs",
    "sam:validate": "SAM_CLI_TELEMETRY=0 sam validate --lint",
    "stripe:reconcile": "npm run build --silent && node scripts/stripe/reconcile.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contracts": "vitest run tests/contracts",
    "test:cloud-drill": "vitest run tests/scripts/sns-subscription-dlq-drill.test.ts",
    "test:delivery-worker": "vitest run tests/events/delivery-requested-event.test.ts tests/application/process-delivery-event.test.ts tests/lambda/delivery-worker.test.ts",
    "test:integration": "npm run dynamodb:bootstrap && vitest run --config vitest.integration.config.ts",
    "test:mock-vendor": "vitest run tests/contracts/mock-delivery-vendor.test.ts",
    "test:publisher-failure-drill": "vitest run tests/scripts/stream-publisher-failure-drill.test.ts",
    "test:sam": "bash scripts/sam/smoke-local.sh",
    "test:stream-publisher": "vitest run tests/events/order-stream-event.test.ts tests/lambda/stream-publisher.test.ts",
    "test:stripe-client": "vitest run tests/integrations/fake-stripe-payment-client.test.ts tests/integrations/stripe-payment-client.test.ts",
    "test:terminal-retry-campaign": "vitest run tests/scripts/sign-webhook.test.ts tests/scripts/terminal-retry-campaign.test.ts",
    "test:vendor-client": "vitest run tests/integrations/delivery-vendor-client.test.ts",
    "test:vendor-rate-limit-drill": "vitest run tests/scripts/vendor-rate-limit-dlq-drill.test.ts",
    "test:webhook": "vitest run tests/application/provider-webhook-validation.test.ts tests/lambda/vendor-webhook.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1091.0",
    "@aws-sdk/client-sns": "3.1091.0",
    "@aws-sdk/client-ssm": "3.1091.0",
    "@aws-sdk/lib-dynamodb": "3.1091.0",
    "@aws-sdk/util-dynamodb": "3.996.7",
    "stripe": "22.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.20.0",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
